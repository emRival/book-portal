# Database
DATABASE_URL="mysql://user:password@db:3306/idn_book"

# Authentication
SECRET_KEY="your-super-secret-key-change-this"

# Cloudflare Turnstile
# Get these from Cloudflare Dashboard > Turnstile
# Default values are for Testing only (Always Pass)
CLOUDFLARE_SITE_KEY="1x00000000000000000000AA"
CLOUDFLARE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Turnstile behavior (optional)
# Max verification attempts before giving up (default: 3)
#TURNSTILE_RETRIES=3
# Timeout per attempt in ms (default: 5000)
#TURNSTILE_TIMEOUT=5000
# If "true", login/registration proceeds when Turnstile is UNREACHABLE
# (network outage). Keep off unless you accept the security tradeoff.
#TURNSTILE_FAIL_OPEN=false
